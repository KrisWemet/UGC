# kie.ai: voiceover, images and talking-head video, plus Claude for research and
# scripts (billed in kie.ai credits). The only required key. https://kie.ai/api-key
KIE_API_KEY=

# Optional: Claude on Anthropic's own API, which adds web search to research.
ANTHROPIC_API_KEY=

# Optional backup: free OpenRouter models, used if the providers above fail. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free


# Optional: Vercel Blob for storing finished videos. Without it, finished videos are
# uploaded to kie.ai file storage, which deletes them after 24 hours.
BLOB_READ_WRITE_TOKEN=

# Optional: protect the app with HTTP basic auth. Strongly recommended once deployed,
# since every render spends credits on your keys.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional: exact caption timing from local Whisper (via the HyperFrames CLI) for
# voices that don't return word timestamps. Runs `npx hyperframes transcribe`.
# ALIGN_CAPTIONS=whisper

# Optional model overrides (defaults in src/lib/config.ts).
# LLM_PROVIDER=kie
# CLAUDE_MODEL=claude-opus-5-5
# KIE_CLAUDE_MODEL=claude-opus-5-5
# KIE_GEMINI_TTS_MODEL=google/gemini-3-8-flash-tts
# KIE_TTS_MODEL=elevenlabs/text-to-speech-multilingual-v2
# KIE_IMAGE_MODEL=seedream/5-flash-text-to-image
# KIE_AVATAR_MODEL=kling/ai-avatar-standard
# KIE_AVATAR_BUDGET_MODEL=infinitalk/from-audio
