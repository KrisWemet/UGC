# Claude: researches the URL and writes the scripts.
ANTHROPIC_API_KEY=

# fal.ai: images, talking-head video, lip-sync. https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs: voiceover with word timestamps (used for captions).
ELEVENLABS_API_KEY=

# Optional: Vercel Blob for storing finished videos. Without it, files go to fal.ai storage.
BLOB_READ_WRITE_TOKEN=

# Optional: protect the app with HTTP basic auth (strongly recommended once deployed,
# since every render spends money on your API keys).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional model overrides (defaults in src/lib/config.ts).
# CLAUDE_MODEL=claude-opus-5-5
# FAL_IMAGE_MODEL=fal-ai/flux-2-pro
# FAL_AVATAR_MODEL=fal-ai/kling-video/ai-avatar/v2/standard
# FAL_IMG2VIDEO_MODEL=fal-ai/minimax/hailuo-2.3-fast/standard/image-to-video
# FAL_LIPSYNC_MODEL=veed/lipsync
# ELEVENLABS_MODEL=eleven_multilingual_v2
